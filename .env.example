# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings > API). Sans ces valeurs, l'app démarre en mode démo.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé Google Maps SDK for Android (console Google Cloud). iOS utilise Apple Maps, pas de clé.
GOOGLE_MAPS_ANDROID_API_KEY=

# Import du catalogue Wikidata uniquement (npm run catalog:import). Clé secrète :
# jamais dans l'app, jamais commitée. Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
