{
  "name": "hotlap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/michroma": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-router": "~58.0.25",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "react": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-maps": "^1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "fflate": "^0.8.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "node scripts/start-go.mjs",
    "start:go:tunnel": "expo start --go --tunnel",
    "server:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/restart-expo.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "expo lint",
    "score:check": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/score-scenarios.ts",
    "catalog:import": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/import-wikidata.ts",
    "catalog:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/catalog.test.ts",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:test:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:beta:android": "npx eas-cli@latest build --profile beta --platform android",
    "cars:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/car-images.test.ts",
    "geo:import": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/import-geonames.ts",
    "circuits:import": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/import-circuits.ts",
    "circuits:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/circuits.test.ts",
    "telemetry:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/telemetry.test.ts",
    "gforce:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/gforce.test.ts",
    "sprint:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/sprint.test.ts",
    "laps:test": "npx -y tsx --tsconfig scripts/tsconfig.json scripts/laps.test.ts"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
